# ============================================================
# MeetingMind AI - Environment Variables Template
# ============================================================
# Rename this file to `.env` and fill in your actual API keys.
# ============================================================

# Your Groq API Key (Required)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Optional - defaults to llama-3.3-70b-versatile)
MODEL_NAME=llama-3.3-70b-versatile

# HuggingFace Embedding Model (Optional - defaults to all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Collection Name (Optional)
COLLECTION_NAME=meeting_transcripts
